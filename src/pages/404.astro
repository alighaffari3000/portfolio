---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 | Page Not Found">
  <Nav />

  <div class="min-h-[70vh] flex items-center justify-center p-4 text-[var(--white)]">
    <div class="max-w-md text-center">
      <div class="text-7xl font-medium text-[var(--sec)] mb-4">404</div>
      <h1 class="text-2xl font-medium mb-2">Page Not Found</h1>
      <p class="text-[var(--white-icon)] text-sm mb-6">
        The project case study or page you are looking for does not exist or has been unpublished.
      </p>
      <a
        href="/projects"
        class="inline-block px-5 py-2.5 rounded-xl border border-[var(--surface-border)] bg-[var(--surface)] text-[var(--white-icon)] text-sm hover:text-white hover:bg-[var(--white-icon-tr)] transition duration-300 ease-in-out"
      >
        &larr; Return to Case Studies
      </a>
    </div>
  </div>

  <Footer />
</Layout>
