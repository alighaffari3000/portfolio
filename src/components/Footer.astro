---
import LikeButton from "./React/LikeButton.tsx";
import { t, profile, type Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const strings = t(locale);
const currentYear = new Date().getFullYear();

const socials = [
  {
    href: profile.githubUrl,
    label: "GitHub",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path></svg>',
  },
  {
    href: profile.telegramUrl,
    label: "Telegram",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path></svg>',
  },
];
---

<!-- No background fill: an opaque `--background` here cut the aurora off in a
     hard horizontal line at the top border. The top border alone is enough to
     separate the footer. -->
<footer class="w-full py-12 border-t border-[var(--surface-border)]">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-10">
      <div class="flex flex-col lg:items-start items-center space-y-6 gap-9">
        <!-- min-w/h-11 on each link = 44px: the 32px icon alone left a hit
             area below the recommended touch target on phones. -->
        <div class="flex gap-8">
          {
            socials.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex flex-col items-center justify-center min-w-11 min-h-11 group"
                aria-label={link.label}
              >
                <div class="text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out">
                  <Fragment set:html={link.icon} />
                </div>
              </a>
            ))
          }
        </div>
        <LikeButton
          client:load
          label={strings.footer.likes}
          actionLabel={strings.footer.like}
          likedLabel={strings.footer.liked}
        />
      </div>

      <div class="flex flex-col items-center space-y-6">
        <div class="grid grid-cols-1 gap-3 w-full max-w-xs py-6">
          {
            [
              { desc: strings.footer.builtWith, name: "Astro", icon: "/svg/astro.svg" },
              { desc: strings.footer.styledWith, name: "TailwindCSS", icon: "/svg/tailwindcss.svg" },
            ].map((tech) => (
              <div class="flex items-center justify-center lg:justify-normal gap-3">
                <span class="text-[var(--white-icon)] text-sm">{tech.desc}</span>
                <img
                  src={tech.icon}
                  alt=""
                  class="h-5 w-5 object-contain filter brightness-0 invert opacity-50"
                  loading="lazy"
                />
                <span class="text-[var(--white-icon)] text-sm">{tech.name}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col items-center lg:items-start space-y-6">
        <div
          class="w-full max-w-xs p-4 rounded-xl border border-[var(--surface-border)] bg-[var(--surface)]"
        >
          <h2 class="text-sm font-medium text-[var(--white)] mb-1">
            {profile.name[locale]}
          </h2>
          <p class="text-xs text-[var(--white-icon)]">{strings.siteDescription}</p>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-[var(--surface-border)]">
      <p class="text-center text-sm text-[var(--white-icon)]">
        © {currentYear} {profile.name[locale]}. {strings.footer.rights}
      </p>
    </div>
  </div>
</footer>
