---
import { t, localizePath, alternatePath, type Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const strings = t(locale);
const otherLocale: Locale = locale === "fa" ? "en" : "fa";
const switchHref = alternatePath(Astro.url.pathname, otherLocale);

interface NavItem {
  label: string;
  href: string;
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: strings.nav.home,
    href: localizePath("/", locale) + "#home",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"></path></svg>`,
  },
  {
    label: strings.nav.projects,
    href: localizePath("/projects", locale),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"></path></svg>`,
  },
  {
    label: strings.nav.contact,
    href: localizePath("/", locale) + "#contact",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path></svg>`,
  },
];
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    class="fixed left-1/2 -translate-x-1/2 z-[100] border border-1 backdrop-blur-xl md:top-6 md:bottom-auto bottom-0 w-full md:w-[33rem]"
  >
    <div class="container mx-auto flex justify-center items-center p-3">
      <ul
        class="flex w-full justify-between md:space-x-6 md:justify-center md:gap-12 gap-6"
      >
        {
          navItems.map((item) => (
            <li class="flex-1 md:flex-none">
              <a
                href={item.href}
                class="flex flex-col items-center gap-1 text-[var(--white-icon)] transition-colors text-xs md:text-base relative group"
              >
                <div class="absolute -left-6 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full transition-all duration-300 scale-0 opacity-0 bg-[#A9FF5B] nav-indicator hidden md:block" />
                <span class="md:hidden flex items-center justify-center w-6 h-6">
                  <Fragment set:html={item.icon} />
                </span>
                <span class="hidden md:inline-block">{item.label}</span>
                <span class="md:hidden">{item.label}</span>
              </a>
            </li>
          ))
        }
        <li class="flex-1 md:flex-none">
          <a
            href={switchHref}
            hreflang={otherLocale}
            aria-label={`Switch language to ${otherLocale === "fa" ? "Persian" : "English"}`}
            class="flex flex-col items-center gap-1 text-[var(--white-icon)] hover:text-white transition-colors text-xs md:text-base"
          >
            <span class="md:hidden flex items-center justify-center w-6 h-6">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path
                  d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM12 20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4C7.58172 4 4 7.58172 4 12C4 16.4183 7.58172 20 12 20ZM4.06189 13H8.02456C8.11683 15.3568 8.72091 17.5924 9.76335 19.5659C6.83382 18.6963 4.62204 16.1349 4.06189 13ZM4.06189 11C4.62204 7.86512 6.83382 5.30373 9.76335 4.43414C8.72091 6.40757 8.11683 8.64322 8.02456 11H4.06189ZM19.9381 11H15.9754C15.8832 8.64322 15.2791 6.40757 14.2367 4.43414C17.1662 5.30373 19.378 7.86512 19.9381 11ZM19.9381 13C19.378 16.1349 17.1662 18.6963 14.2367 19.5659C15.2791 17.5924 15.8832 15.3568 15.9754 13H19.9381ZM10.0276 13H13.9724C13.8687 15.0796 13.2909 17.0407 12.3223 18.7749L12 19.3245L11.6777 18.7749C10.7091 17.0407 10.1313 15.0796 10.0276 13ZM10.0276 11C10.1313 8.92037 10.7091 6.95935 11.6777 5.22506L12 4.67554L12.3223 5.22506C13.2909 6.95935 13.8687 8.92037 13.9724 11H10.0276Z"
                ></path>
              </svg>
            </span>
            <span>{strings.nav.switchTo}</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>
</div>

<style>
  /*
    No `transform: translateX(-50%)` here. The centering comes from the
    `-translate-x-1/2` utility, which in Tailwind v4 compiles to the CSS
    `translate` property — a separate property that COMPOSES with `transform`
    rather than overriding it. Declaring both shifted the nav a full -100%.
  */
  /*
    The compact pill is the only state — it used to be reached by scrolling,
    with the width interpolated in JS from 80% down to 33rem. Now it is how the
    nav starts, so nothing about it is scroll-driven.
  */
  nav {
    background-color: rgba(20, 20, 20, 0.9);
    border-color: #ffffff10;
    border-radius: 9999px;
  }

  /* Same reason: drive `scale`/`translate` properties, not `transform`. */
  nav a.active .nav-indicator {
    scale: 1;
    opacity: 1;
  }

  nav a.active {
    color: white !important;
  }

  /* On phones the nav is a full-width bottom bar, not a floating pill. */
  @media (max-width: 767px) {
    nav {
      width: 100%;
      bottom: 0;
      left: 50%;
      position: fixed;
      border-radius: 1rem 1rem 0 0;
    }
  }
</style>

<script>
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      const target = e.currentTarget as HTMLAnchorElement;
      const targetId = target.getAttribute("href")?.substring(1) || "";
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: "smooth",
        });
      }
    });
  });
</script>
