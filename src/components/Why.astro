---
import { t, type Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const strings = t(locale);
const why = strings.why;
---

<section class="py-12 border-t border-[var(--surface-border)] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <p class="text-lg text-[var(--sec)] mb-2 shiny-sec">{why.eyebrow}</p>
    <h2 class="text-4xl md:text-5xl font-medium mb-8">{why.heading}</h2>

    <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        why.items.map((item) => (
          <li class="flex items-start gap-3 p-4 rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)]">
            <span class="text-[var(--sec)] leading-6">&bull;</span>
            <span class="text-[var(--white-icon)] text-sm md:text-base">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
