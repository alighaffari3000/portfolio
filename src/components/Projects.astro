---
import { db } from '../lib/db';
import { t, localizePath, resolveProject, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
  limit?: number;
}

const { locale = 'en', limit } = Astro.props;
const strings = t(locale);

const rows = await db.project.findMany({
  where: { published: true },
  orderBy: [{ order: 'asc' }, { createdAt: 'desc' }],
  ...(limit ? { take: limit } : {}),
});
const projects = rows.map((row) => resolveProject(row, locale));
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">{strings.projects.eyebrow}</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">{strings.projects.heading}</h3>

    {projects.length === 0 ? (
      <div class="p-8 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] text-center text-[var(--white-icon)]">
        {strings.projects.empty}
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          projects.map((project) => {
            const statusText = project.demoUrl ? strings.projects.statusDeployed : strings.projects.statusInProgress;
            const statusDotColor = project.demoUrl ? "bg-[#A9FF5B]" : "bg-[var(--sec)]";

            return (
              <div class="group">
                <a
                  href={localizePath(`/projects/${project.slug}`, locale)}
                  class="block"
                >
                  <div class="rounded-2xl overflow-hidden shadow-lg border border-[var(--white-icon-tr)] bg-[#1414149c] mb-4">
                    {project.heroImage ? (
                      <img
                        src={project.heroImage}
                        alt={project.title}
                        class="w-full h-48 md:h-72 object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    ) : (
                      /* Neutral placeholder — never stretch a logo to fill the card. */
                      <div class="w-full h-48 md:h-72 flex items-center justify-center bg-[#141414]">
                        <span class="text-6xl font-medium text-[var(--white-icon-tr)] select-none">
                          {project.title.trim().charAt(0).toUpperCase()}
                        </span>
                      </div>
                    )}
                  </div>
                  <div class="px-3">
                    <h4 class="text-2xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">
                      {project.title}
                    </h4>
                    <div class="flex items-center gap-2 mt-1">
                      <span class={`inline-block w-2 h-2 rounded-full ${statusDotColor}`}></span>
                      <span class="text-sm text-[var(--white-icon)]">
                        {statusText}
                      </span>
                    </div>
                  </div>
                </a>
                {/* Action links stay OUTSIDE the card anchor — nesting <a> in <a> is invalid HTML. */}
                <div class="flex gap-2 px-3 mt-3">
                      {project.githubUrl && (
                        <a
                          target="_blank"
                          href={project.githubUrl}
                          aria-label="GitHub"
                          class="size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="size-7"
                          >
                            <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
                          </svg>
                        </a>
                      )}
                      <a
                        href={localizePath(`/projects/${project.slug}`, locale)}
                        aria-label="View Case Study"
                        class="size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          class="size-7"
                        >
                          <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                        </svg>
                      </a>
                </div>
              </div>
            );
          })
        }
      </div>
    )}
  </div>
</section>
