---
import * as simpleIcons from "simple-icons";

/*
  Official brand marks from the `simple-icons` package — bundled locally, so the
  VPS needs no external asset host.

  Only technologies that HAVE an official mark appear here. Concepts from the
  stack (RAG, embeddings, vector databases, function calling, REST APIs, OCR)
  have no logo and are covered in the services section instead. OpenAI is absent
  because simple-icons no longer ships its mark; drawing a lookalike would
  misrepresent the trademark.
*/
const entries: { slug: string; label?: string }[] = [
  { slug: "python" },
  { slug: "fastapi" },
  { slug: "typescript" },
  { slug: "javascript" },
  { slug: "postgresql" },
  { slug: "sqlite" },
  { slug: "docker" },
  { slug: "linux" },
  { slug: "nginx" },
  { slug: "googlegemini", label: "Gemini" },
  { slug: "modelcontextprotocol", label: "MCP" },
  { slug: "n8n" },
  { slug: "telegram", label: "Telegram Bot API" },
  { slug: "git" },
];

/** Relative luminance, so near-black marks stay visible on the #101010 page. */
function luminance(hex: string): number {
  const channel = (value: number) => {
    const c = value / 255;
    return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
  };
  const r = parseInt(hex.slice(0, 2), 16);
  const g = parseInt(hex.slice(2, 4), 16);
  const b = parseInt(hex.slice(4, 6), 16);
  return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
}

const icons = entries
  .map(({ slug, label }) => {
    const key = "si" + slug.charAt(0).toUpperCase() + slug.slice(1);
    const icon = (simpleIcons as Record<string, any>)[key];
    if (!icon) return null;
    return {
      title: label ?? icon.title,
      path: icon.path,
      // Dark marks (SQLite #003B57, MCP #000000) would vanish — fall back to the
      // muted foreground instead of the brand colour.
      color: luminance(icon.hex) < 0.06 ? "var(--white-icon)" : `#${icon.hex}`,
    };
  })
  .filter(Boolean) as { title: string; path: string; color: string }[];
---

<div class="relative overflow-x-hidden py-8" dir="ltr">
  <div
    class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[var(--background)] to-transparent z-20"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[var(--background)] to-transparent z-20"
  >
  </div>

  <div class="flex animate-scroll w-max will-change-transform">
    {
      [...icons, ...icons].map((icon, index) => (
        <div
          class="flex items-center gap-3 pr-12 md:pr-20 group"
          aria-hidden={index >= icons.length ? "true" : "false"}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill={icon.color}
            class="h-7 w-7 shrink-0 opacity-80 transition-transform duration-300 group-hover:scale-110"
            role="img"
            aria-label={icon.title}
          >
            <path d={icon.path} />
          </svg>
          <span class="text-lg font-medium text-[var(--white-icon)] whitespace-nowrap">
            {icon.title}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  @keyframes scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
  .animate-scroll {
    animation: scroll 60s linear infinite;
  }

  @media (min-width: 768px) {
    .animate-scroll {
      animation-duration: 50s;
    }
  }
</style>
