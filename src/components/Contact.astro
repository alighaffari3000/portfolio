---
import { t, profile, type Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const strings = t(locale);
const c = strings.contact;

const channels = [
  {
    label: c.telegram,
    value: `@${profile.telegramHandle}`,
    href: profile.telegramUrl,
    external: true,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path></svg>`,
  },
  {
    label: c.phone,
    value: profile.phoneDisplay,
    href: `tel:${profile.phone}`,
    external: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M21 16.42V19.956C21 20.504 20.552 20.948 20.004 20.9985C19.5673 21.0388 19.2109 21.06 18.936 21.06C10.0294 21.06 2.93994 13.9706 2.93994 5.06396C2.93994 4.78904 2.96114 4.43264 3.00144 3.99596C3.05194 3.44796 3.49594 2.99996 4.04394 2.99996H7.57994C7.84844 2.99996 8.07394 3.20216 8.10094 3.46926C8.12594 3.71406 8.14894 3.90926 8.17094 4.05766C8.39294 5.60336 8.84794 7.07296 9.50294 8.42596C9.60694 8.64036 9.54044 8.89826 9.34544 9.03566L7.18744 10.5773C8.50644 13.6516 10.3883 15.5335 13.4626 16.8525L15.0026 14.6984C15.1416 14.5013 15.4026 14.4341 15.6194 14.5391C16.9724 15.1934 18.4416 15.6477 19.9866 15.8703C20.1346 15.8916 20.3286 15.9143 20.5716 15.9391C20.8386 15.9666 21 16.1917 21 16.42Z"></path></svg>`,
  },
  {
    label: c.github,
    value: "alighaffari3000",
    href: profile.githubUrl,
    external: true,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path></svg>`,
  },
];
---

<section id="contact" class="w-full py-12 border-t border-[var(--surface-border)]">
  <div class="max-w-5xl mx-auto">
    <!-- The eyebrow is a label, not a heading. As an <h2> above an <h3> it
         inverted the outline: screen readers got the 18px kicker as the
         section's heading and the real 48px title as its subsection. -->
    <p class="text-lg text-[var(--sec)] mb-2 shiny-sec">{c.eyebrow}</p>
    <h2 class="text-4xl md:text-5xl font-medium mb-4">{c.heading}</h2>
    <p class="text-[var(--white-icon)] mb-8 max-w-2xl">{c.intro}</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {
        channels.map((channel) => (
          <a
            href={channel.href}
            target={channel.external ? "_blank" : undefined}
            rel={channel.external ? "noopener noreferrer" : undefined}
            class="flex items-center gap-4 p-4 rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)] text-[var(--white-icon)] hover:text-white hover:bg-[var(--white-icon-tr)] transition duration-300 ease-in-out"
          >
            <span class="text-[var(--sec)]">
              <Fragment set:html={channel.icon} />
            </span>
            <span class="min-w-0">
              <!-- No `opacity-70` here: it multiplied with the parent's
                   --white-icon alpha (0.6) down to an effective 0.42, which
                   measured 3.77:1 against the page — under the 4.5:1 floor. -->
              <span class="block text-xs uppercase tracking-wide">
                {channel.label}
              </span>
              <span class="block text-base truncate" dir="ltr">
                {channel.value}
              </span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="text-[var(--white-icon)] text-sm mt-8 max-w-3xl leading-relaxed">
      {c.cta}
    </p>
  </div>
</section>
