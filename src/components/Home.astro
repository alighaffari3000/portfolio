---
import LetterGlitch from "./React/LetterGlitch.tsx";
import LogoWall from "./LogoWall.astro";
import SkillsList from "./React/SkillsList.tsx";
import { t, profile, localizePath, type Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const strings = t(locale);
const hero = strings.hero;
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:py-36 pb-14">
    <div class="text-start space-y-4">
      <p class="text-md md:text-lg text-[var(--white-icon)] shiny-white">
        {hero.greeting}
      </p>
      <div
        class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:gap-8 md:gap-4"
      >
        <!-- `text-pretty` is gone along with the size pair: it only affects how
             a line breaks, and `whitespace-nowrap` right next to it forbids
             breaking at all, so it could never have done anything here. -->
        <h1
          class="text-[var(--white)] heading-hero font-medium leading-tight whitespace-nowrap"
        >
          {hero.titleLine1} <br /> {hero.titleLine2}
        </h1>
        <p class="text-md md:text-2xl text-[var(--white-icon)]">
          {hero.taglineBefore}<span class="text-[var(--sec)] shiny-sec"
            >{hero.taglineHighlight}</span
          >{hero.taglineAfter}
        </p>
      </div>

      <p class="text-sm text-[var(--white-icon)] pt-2">{hero.stat}</p>

      <!--
        The site had no button at all before this: three round icon links were
        the only thing to press anywhere on the page, and none of them said
        where they went. These deliberately reuse the filled/outlined pair
        already used for "Live demo" and "GitHub repository" on the case study
        pages, so the site has one button language rather than two.

        `py-3` on 1rem text clears 44px of height, which the icon links below
        only reach through their own padding.

        The contact link is a bare `#contact` rather than `/#contact`: this
        component only ever renders on the home page, and a bare hash is
        guaranteed to be handled as an in-page scroll rather than routed.
      -->
      <div class="flex flex-wrap items-center gap-3 pt-5">
        <a
          href={localizePath('/projects', locale)}
          class="px-6 py-3 rounded-full bg-[var(--sec)] text-black font-semibold text-base hover:opacity-90 transition-opacity"
        >
          {hero.ctaWork}
        </a>
        <a
          href="#contact"
          class="px-6 py-3 rounded-full bg-[var(--surface)] border border-[var(--surface-border)] text-[var(--white)] font-semibold text-base hover:bg-[var(--white-icon-tr)] transition-colors"
        >
          {hero.ctaContact}
        </a>
      </div>

      <div class="flex justify-start gap-2 pt-3 md:pt-6">
        <a
          target="_blank"
          rel="noopener noreferrer"
          href={profile.githubUrl}
          aria-label="GitHub"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--surface-border)] p-3 rounded-xl bg-[var(--surface)] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
            ></path>
          </svg>
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href={profile.telegramUrl}
          aria-label="Telegram"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--surface-border)] p-3 rounded-xl bg-[var(--surface)] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"
            ></path>
          </svg>
        </a>
        <a
          href={`tel:${profile.phone}`}
          aria-label={strings.contact.phone}
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--surface-border)] p-3 rounded-xl bg-[var(--surface)] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M21 16.42V19.956C21 20.504 20.552 20.948 20.004 20.9985C19.5673 21.0388 19.2109 21.06 18.936 21.06C10.0294 21.06 2.93994 13.9706 2.93994 5.06396C2.93994 4.78904 2.96114 4.43264 3.00144 3.99596C3.05194 3.44796 3.49594 2.99996 4.04394 2.99996H7.57994C7.84844 2.99996 8.07394 3.20216 8.10094 3.46926C8.12594 3.71406 8.14894 3.90926 8.17094 4.05766C8.39294 5.60336 8.84794 7.07296 9.50294 8.42596C9.60694 8.64036 9.54044 8.89826 9.34544 9.03566L7.18744 10.5773C8.50644 13.6516 10.3883 15.5335 13.4626 16.8525L15.0026 14.6984C15.1416 14.5013 15.4026 14.4341 15.6194 14.5391C16.9724 15.1934 18.4416 15.6477 19.9866 15.8703C20.1346 15.8916 20.3286 15.9143 20.5716 15.9391C20.8386 15.9666 21 16.1917 21 16.42Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- The hero block above gets no `.reveal`: it is already on screen at
         scroll 0, where an entry-range animation resolves to its end state
         anyway. Marking it would add nothing and risk a flash on load. -->
    <div class="reveal">
      <LogoWall />
    </div>

    <!-- `lg:items-stretch` is what makes the glitch panel match the height of the
         skills accordion beside it; below lg the two are stacked, so the fixed
         square sizing still applies there.

         The lg padding-top drops the panel past the "What I do?" heading so its
         top edge lines up with the first accordion row rather than the heading:
         36px (the md offset) + 40px heading line-box + 24px heading gap. -->
    <div class="flex flex-col lg:flex-row items-center lg:items-stretch gap-8">
      <SkillsList client:load heading={strings.services.heading} groups={strings.services.groups} />
      <div
        class="reveal flex justify-center w-[290px] h-[290px] md:w-full md:h-[292px] lg:h-auto pt-3 md:pt-9 lg:pt-25"
      >
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }

  /*
    The sheen loops forever with nothing to trigger or stop it. Holding it at
    the resting position keeps the gradient fill — only the travel stops.
  */
  @media (prefers-reduced-motion: reduce) {
    .shiny-sec {
      animation: none;
      background-position: 0% 50%;
    }
  }
</style>
