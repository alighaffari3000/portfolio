ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<generate-with-bcrypt-e.g.-node-e-"import('bcrypt').then(b=>console.log(b.default.hashSync('your_pw',10)))">
SESSION_SECRET=c8d9e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8
DATABASE_URL="file:./dev.db"
UPLOADS_DIR="./uploads"

# Hosts this server may be reached on (comma separated, no protocol).
# Required: an empty list makes Astro treat every request as http://localhost,
# which breaks the built-in CSRF check for all form/multipart POSTs.
# On the VPS set this to your real domain, e.g. example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
